# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins (CORS).
FRONTEND_URLS=http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────────
# Required. The app refuses to start without it.
# IMPORTANT: under Lambda, point this at the provider's POOLED endpoint
# (Neon: the host containing '-pooler'). The app caps its own pool at 1 there;
# the provider's pooler is what absorbs concurrency.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Pool size for local/container runs only; ignored under Lambda.
DB_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=7d
GOOGLE_CLIENT_ID=

# ── Email (Gmail requires an App Password when 2FA is on) ─────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── Cloudinary (images + video) ───────────────────────────────────────────────
# NOTE: the previous value of CLOUDINARY_API_SECRET was committed to this file in
# a public repository and must be treated as compromised. Rotate it in the
# Cloudinary console; do not reuse it in the new environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── PhonePe ───────────────────────────────────────────────────────────────────
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=production
# Username/password you configure for the webhook in the PhonePe dashboard.
# PhonePe sends SHA256("<username>:<password>") in the Authorization header of
# every callback, and POST /api/orders/payment/callback rejects anything else.
# If unset the header check is skipped (and a warning is logged) -- payments are
# still safe, because order state is always re-verified with PhonePe's status
# API rather than trusted from the callback body -- but set both in production.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Public base URL of this API. PhonePe posts its settlement callback here, so a
# stale value means payments succeed at the gateway and are never recorded.
BACKEND_URL=http://localhost:3001

# Where PhonePe redirects the customer after payment.
FRONTEND_URL=http://localhost:8080

# ── WhatsApp Cloud API (docs/whatsapp-integration.md) ─────────────────────────
# off (default) | mock (no calls to Meta; for local dev) | live
WHATSAPP_MODE=off
# Server-side only. Never put any of these in a VITE_* variable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The number customers message, digits with country code, e.g. 918249581682
WHATSAPP_BUSINESS_NUMBER=
# Any long random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# false = zero message cost: nothing is sent outside the free 24-hour window.
WHATSAPP_PAID_TEMPLATES=false
WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_QUOTE_UPDATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Outside NODE_ENV=production, live mode only messages these numbers.
WHATSAPP_TEST_RECIPIENTS=
WHATSAPP_BODY_RETENTION_DAYS=90
