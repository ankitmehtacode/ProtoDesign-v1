{
  "name": "protodesign-backend",
  "version": "1.0.0",
  "description": "ProtoDesign Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx app.ts",
    "start": "tsx app.ts",
    "build": "node build.mjs",
    "package": "npm run build && cd dist && zip -qr ../lambda.zip lambda.mjs && echo 'built lambda.zip'",
    "db:setup": "psql -U postgres -f migrations/000_create_database.sql",
    "test": "node test/storage.presign.test.mjs && node --test test/orders.lifecycle.test.mjs && tsx --test test/lambda.body.test.mjs test/products.update.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.0",
    "pg-promise": "^12.3.0",
    "serverless-http": "^3.2.0",
    "streamifier": "^0.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
